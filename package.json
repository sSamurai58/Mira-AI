{
  "name": "mira-ai",
  "version": "0.0.1",
  "private": true,
  "description": "Mira — local voice AI assistant",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && npm run electron:dev\"",
    "electron:dev": "tsc -p tsconfig.electron.json && cross-env MIRA_DEV=1 electron .",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "db:check": "tsx scripts/db-check.ts",
    "p1:smoke": "tsx scripts/p1-smoke.ts",
    "p2:smoke": "tsx scripts/p2-smoke.ts",
    "p3:smoke": "tsx scripts/p3-smoke.ts",
    "p4:smoke": "tsx scripts/p4-smoke.ts",
    "p5:smoke": "tsx scripts/p5-smoke.ts",
    "p6:smoke": "tsx scripts/p6-smoke.ts",
    "start": "npm run build && electron ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
