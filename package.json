{
  "name": "mira-ai",
  "version": "0.1.20",
  "private": true,
  "description": "Mira — local voice AI assistant",
  "author": "Mira",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sSamurai58/Mira-AI.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && npm run electron:dev\"",
    "electron:dev": "tsc -p tsconfig.electron.json && cross-env MIRA_DEV=1 ELECTRON_OZONE_PLATFORM_HINT=x11 electron . --use-gl=angle --use-angle=swiftshader --remote-debugging-port=9223",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "brand-icons:vendor": "node scripts/vendor-brand-icons.mjs",
    "db:check": "tsx scripts/db-check.ts",
    "p1:smoke": "tsx scripts/p1-smoke.ts",
    "chat-diversity:smoke": "tsx scripts/chat-diversity-smoke.ts",
    "core-level:smoke": "tsx scripts/core-level-smoke.ts",
    "p2:smoke": "tsx scripts/p2-smoke.ts",
    "elevenlabs:smoke": "tsx scripts/elevenlabs-smoke.ts",
    "p3:smoke": "tsx scripts/p3-smoke.ts",
    "p4:smoke": "tsx scripts/p4-smoke.ts",
    "p5:smoke": "tsx scripts/p5-smoke.ts",
    "p6:smoke": "tsx scripts/p6-smoke.ts",
    "p7:smoke": "tsx scripts/p7-smoke.ts",
    "p8:smoke": "tsx scripts/p8-smoke.ts",
    "p9:smoke": "tsx scripts/p9-smoke.ts",
    "p10:smoke": "tsx scripts/p10-smoke.ts",
    "integ:smoke": "tsx scripts/integ-settings-smoke.ts",
    "p11:smoke": "tsx scripts/p11-smoke.ts",
    "f11:smoke": "tsx scripts/f11-smoke.ts",
    "f13:smoke": "tsx scripts/f13-smoke.ts",
    "f9:smoke": "tsx scripts/f9-smoke.ts",
    "f-rest:smoke": "tsx scripts/f-rest-smoke.ts",
    "f-all:smoke": "tsx scripts/f-all-smoke.ts",
    "paths:smoke": "tsx scripts/paths-smoke.ts",
    "custom-commands:smoke": "tsx scripts/custom-commands-smoke.ts",
    "protocol-sequence:smoke": "tsx scripts/protocol-sequence-smoke.ts",
    "pack": "npm run build && electron-builder --config electron-builder.yml",
    "pack:dir": "npm run build && electron-builder --config electron-builder.yml --dir",
    "pack:win": "npm run build && electron-builder --win --x64 --config electron-builder.yml --publish never",
    "pack:windows": "npm run pack:win",
    "release": "npm run build && electron-builder --config electron-builder.yml --publish always",
    "start": "npm run build && electron ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^18.0.10",
    "electron-updater": "^6.8.11",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  }
}
