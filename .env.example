# Mira local config — copy to `.env` and fill. Never commit `.env`.

# SQLite database file (created on first launch)
DATABASE_PATH=./data/mira.db

# LLM (P1)
# Без ключа по умолчанию используется mock.
# LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ASR / TTS (P2) — по умолчанию Web Speech API в Electron/Chromium.
# ASR_PROVIDER=webspeech
# TTS_PROVIDER=webspeech

# Web tools (P4)
# WEB_ENABLED=true
# WEB_ALLOWLIST=*
# WEB_FETCH_CONFIRM=true

# Screen / browser (P5)
# SCREEN_ENABLED=true
# SCREEN_CONTROL_ENABLED=true
# OS_PRIORITY=linux,windows,macos
# BROWSER_ENABLED=true
# BROWSER_PREFERRED=chromium
# BROWSER_OPEN_CONFIRM=true
# MIRA_CONFIRM_AUTO=  # accept|deny — только для smoke/headless

# Messengers (P6) — Telegram first; WA/IG stubs
# MESSAGING_ENABLED=true
# MESSAGING_PRIMARY=telegram
# MESSAGING_MODE=dry-run
# MESSAGING_CONFIRM=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DEFAULT_CHAT_ID=

# Optional app
# MIRA_THEME=deep-sea-neon
