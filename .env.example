# Mira local config — copy to `.env` and fill. Never commit `.env`.

# SQLite — в библиотеке Mira: mira/library/database/ (создаётся при старте)
DATABASE_PATH=./mira/library/database/mira.db

# LLM
# Без ключа по умолчанию используется mock.
# LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_PROVIDER=claude
# LLM_PROVIDER=gemini
# LLM_PROVIDER=grok
# LLM_PROVIDER=offline
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-2-latest
# VISION_ENABLED=true
# OFFLINE_MODEL_PATH=


# Profiles (F10) — API keys stay in .env, not in profiles.json
# MIRA_PROFILE_ID=local

# ASR / TTS — Web Speech by default; engine also selectable in UI
# ASR_PROVIDER=webspeech
# TTS_PROVIDER=webspeech

# Web tools (P4)
# WEB_ENABLED=true
# WEB_ALLOWLIST=duckduckgo.com,api.duckduckgo.com
# WEB_FETCH_CONFIRM=true
# Private/link-local destinations always blocked (SSRF guard).

# Screen / browser (P5)
# SCREEN_ENABLED=true
# SCREEN_CONTROL_ENABLED=true
# OS_PRIORITY=linux,windows,macos
# BROWSER_ENABLED=true
# BROWSER_PREFERRED=chromium
# BROWSER_OPEN_CONFIRM=true
# BROWSER_SYSTEM_HISTORY=false
# MIRA_CONFIRM_AUTO=  # accept|deny — только для smoke/headless
# MIRA_OWNER_ID=local
# MIRA_DESKTOP_TOOLS=true
# MIRA_WEB_SAFE=false

# Messengers — Telegram live; WA/IG via optional bridge or dry-run
# MESSAGING_ENABLED=true
# MESSAGING_PRIMARY=telegram
# MESSAGING_MODE=dry-run
# MESSAGING_CONFIRM=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_DEFAULT_CHAT_ID=
# WHATSAPP_BRIDGE_URL=
# WHATSAPP_DEFAULT_CHAT_ID=
# INSTAGRAM_BRIDGE_URL=
# INSTAGRAM_DEFAULT_CHAT_ID=

# Terminal (P7)
# TERMINAL_ENABLED=true
# TERMINAL_SHELL=/bin/bash
# TERMINAL_CWD=.
# TERMINAL_FONT_SIZE=14
# TERMINAL_SCROLLBACK=2000
# TERMINAL_CONFIRM_DANGEROUS=true

# Blender (P10)
# BLENDER_ENABLED=true
# BLENDER_PATH=
# BLENDER_MODE=dry-run
# BLENDER_CONFIRM=true

# Confirm policy (F12)
# MIRA_CONFIRM_MODE=always
# MIRA_CONFIRM_DANGEROUS=messaging,mail,terminal,forget,files,iot,camera,screen,backup

# Mail (F4)
# MAIL_ENABLED=true
# MAIL_MODE=dry-run
# MAIL_ACCOUNT=
# MAIL_SMTP_HOST=
# MAIL_IMAP_HOST=

# HUD
# HUD_ENABLED=true
# HUD_ALWAYS_ON_TOP=true

# Optional app
# MIRA_THEME=deep-sea-neon
