# Mira local config — copy to `.env` and fill. Never commit `.env`.

# SQLite database file (created on first launch)
DATABASE_PATH=./data/mira.db

# LLM (P1+) — leave empty in P0
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=

# ASR / TTS (P2+)
# ASR_PROVIDER=
# TTS_PROVIDER=
# TTS_VOICE=

# Optional app
# MIRA_THEME=deep-sea-neon
